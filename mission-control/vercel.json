{
  "crons": [
    { "path": "/api/cron/hourly", "schedule": "0 2 * * *"   },
    { "path": "/api/cron/daily",  "schedule": "0 9 * * *"   },
    { "path": "/api/cron/social", "schedule": "0 10 * * *"  },
    { "path": "/api/cron/weekly", "schedule": "0 3 * * *"   }
  ],
  "buildCommand": "npx prisma migrate deploy && npx prisma generate && next build",
  "installCommand": "npm install && npx prisma generate"
}
